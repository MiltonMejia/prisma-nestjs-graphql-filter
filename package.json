{
	"name": "prisma-nestjs-graphql-filter",
	"version": "2.0.0",
	"description": "This package helps you to reduce boilerplate if you want to create Prisma filter input in Graphql",
	"type": "module",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"build": "rimraf lib && tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint ."
	},
	"keywords": [
		"graphql",
		"nestjs",
		"decorator",
		"prisma",
		"input",
		"orderBy"
	],
	"author": "mefam",
	"license": "MIT",
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/core": "^12.0.0",
		"@nestjs/graphql": "^14.0.0",
		"graphql": "^16.11.0 || ^17.0.0",
		"reflect-metadata": "^0.1.13 || ^0.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/common": "^12.0.3",
		"@nestjs/core": "^12.0.3",
		"@nestjs/graphql": "^14.0.0",
		"@nestjs/testing": "^12.0.3",
		"@types/node": "^22.20.3",
		"eslint": "^10.10.0",
		"graphql": "^16.14.2",
		"prettier": "^3.9.7",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.1.3",
		"rxjs": "^7.8.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	},
	"files": [
		"lib/**/*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/MiltonMejia/prisma-nestjs-graphql-filter.git"
	}
}
